PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=city_cycle_v1

# Generate a long random string for production, e.g.: openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production

# SuperAdmin always logs in with these credentials, even if the database is unreachable.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Comma-separated list of origins allowed to call this API (browser CORS check).
# Same-domain deployments (frontend + backend behind one reverse proxy, e.g.
# https://yourdomain.com with /api proxied to this server) don't strictly need
# this, since the browser sees it as one origin - but set it anyway for
# defense-in-depth. Leave unset in local dev to allow all origins.
# Example: CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=
